# Shell entry points must run from Windows/WSL checkouts and release bundles.
*.sh text eol=lf

# Vendored bundles are verified byte-for-byte against upstream checksums.
# Never let Windows autocrlf rewrite the assets embedded in release binaries.
crates/aden-cli/assets/*.min.js -text
crates/aden-cli/assets/CHECKSUMS text eol=lf

# Frozen regression datasets are hashed as LF-canonical content. Keep working
# trees LF on Windows so local tools and lock checks stay aligned.
scripts/regression-lock.json text eol=lf
scripts/eval-sets/** text eol=lf
scripts/agent-bench/** text eol=lf
scripts/heldout-context/** text eol=lf
scripts/passage-context/** text eol=lf
