#!/bin/bash
# Aden Pre-Commit Hook
# Fails the commit if CRITICAL drift is detected in the repository.
# Install: cp tools/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

HOOK_NAME="Aden Pre-Commit"
echo "[$HOOK_NAME] Checking documentation health..."

# Only scan files staged for commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "[$HOOK_NAME] No staged files. Skipping."
    exit 0
fi

# Run aden heal --scan on the repo root
# If --fail-on-critical is supported, use it; otherwise parse output
if command -v aden >/dev/null 2>&1; then
    OUTPUT=$(aden heal --scan . 2>&1 || true)
    echo "$OUTPUT"

    if echo "$OUTPUT" | grep -q "CRITICAL"; then
        echo ""
        echo "[$HOOK_NAME] ERROR: Critical drift detected."
        echo "[$HOOK_NAME] Review the drift above or run: aden heal --scan --propose"
        echo "[$HOOK_NAME] Commit blocked until resolved."
        exit 1
    fi
else
    echo "[$HOOK_NAME] WARNING: 'aden' CLI not found in PATH. Skipping check."
fi

echo "[$HOOK_NAME] Documentation health check passed."
exit 0
