#!/bin/bash
# Aden Pre-Commit Hook — Security-Hardened
# Install: cp tools/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# This hook enforces three gates before every commit:
#   1. SECRET SCAN — rejects private keys, tokens, and credentials
#   2. ADEN CHECK — validates all <<refs>> resolve and no drift
#   3. TEST GATE — runs cargo test --workspace

set -euo pipefail

HOOK_NAME="Aden Pre-Commit"
PASS=0
FAIL=1
EXIT_CODE=$PASS

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

function banner() {
    echo ""
    echo "══════════════════════════════════════════════════"
    echo "  $1"
    echo "══════════════════════════════════════════════════"
}

banner "$HOOK_NAME"

# ── Gate 1: Secret Scan ───────────────────────────
SECRET_PATTERNS=(
    "-----BEGIN (RSA |EC |OPENSSH |ENCRYPTED |PRIVATE KEY-----)"
    "-----BEGIN DSA PRIVATE KEY-----"
    "-----BEGIN EC PRIVATE KEY-----"
    "BEGIN CERTIFICATE-----"
    "AKIA[0-9A-Z]{16}"
    "ghp_[a-zA-Z0-9]{36,}"
    "sk-[a-zA-Z0-9]{32,}"
    "xox[baprs]-[0-9A-Za-z-]{10,}"
    "bearer\s+[a-zA-Z0-9_\-]{20,}"
    "api[_-]?key\s*[:=]\s*['\"]?[a-zA-Z0-9_\-]{16,}"
    "password\s*[:=]\s*['\"][^'\"]{4,}['\"]"
    "secret\s*[:=]\s*['\"][^'\"]{4,}['\"]"
    "token\s*[:=]\s*['\"][^'\"]{8,}['\"]"
)

# Absolute home paths and agent session artifacts — privacy leak, not credentials.
PATH_LEAK_PATTERNS=(
    "/home/[a-zA-Z0-9._-]+/"
    "/Users/[a-zA-Z0-9._-]+/"
    "\.grok/sessions/"
    "updates\.jsonl"
)

STAGED=$(git diff --cached --name-only --diff-filter=ACM || true)
if [ -z "$STAGED" ]; then
    echo -e "${YELLOW}No staged files. Skipping gates.${NC}"
    exit 0
fi

should_skip_privacy_scan() {
    echo "$1" | grep -qE '^(tools/git-hooks/pre-commit|docs/policy\.adoc|adr-001|MAINTAINERS|crates/aden-mcp/src/lib\.rs|crates/aden-cli/src/util\.rs)$'
}

SECRET_FOUND=0
PATH_LEAK_FOUND=0
for file in $STAGED; do
    if should_skip_privacy_scan "$file"; then
        continue
    fi
    for pattern in "${SECRET_PATTERNS[@]}"; do
        if git show ":$file" 2>/dev/null | grep -inE "$pattern" >/dev/null 2>&1; then
            echo -e "${RED}SECRET LEAK DETECTED in $file${NC}"
            echo -e "${RED}  Pattern: $pattern${NC}"
            SECRET_FOUND=1
        fi
    done
    for pattern in "${PATH_LEAK_PATTERNS[@]}"; do
        if git show ":$file" 2>/dev/null | grep -inE "$pattern" >/dev/null 2>&1; then
            echo -e "${RED}PATH/SESSION LEAK DETECTED in $file${NC}"
            echo -e "${RED}  Pattern: $pattern${NC}"
            PATH_LEAK_FOUND=1
        fi
    done
    # Never stage agent-runtime artifacts (even if .gitignore is bypassed with -f).
    if echo "$file" | grep -qE '(^|/)\.(grok|cursor|codex|windsurf)/|\.updates\.jsonl$|(^|/)\.env(\.|$)'; then
        echo -e "${RED}BLOCKED ARTIFACT in $file${NC}"
        echo -e "${RED}  Agent runtime / env files must not be committed.${NC}"
        PATH_LEAK_FOUND=1
    fi
done

if [ $SECRET_FOUND -ne 0 ]; then
    echo ""
    echo -e "${RED}COMMIT BLOCKED: Secrets detected in staged files.${NC}"
    echo "Remove the secrets and re-stage. Never commit private keys or tokens."
    EXIT_CODE=$FAIL
fi

if [ $PATH_LEAK_FOUND -ne 0 ]; then
    echo ""
    echo -e "${RED}COMMIT BLOCKED: Home paths or agent session artifacts in staged files.${NC}"
    echo "Redact absolute paths and never commit .grok/.cursor session data."
    EXIT_CODE=$FAIL
fi

# ── Gate 2: Aden Integrity ─────────────────────────
echo ""
echo "Running aden check..."
if command -v aden >/dev/null 2>&1; then
    if ! aden check . >/dev/null 2>&1; then
        echo -e "${RED}aden check FAILED. Run 'aden check .' to see errors.${NC}"
        EXIT_CODE=$FAIL
    else
        echo -e "${GREEN}aden check passed.${NC}"
    fi
else
    echo -e "${YELLOW}aden CLI not in PATH — skipping integrity gate.${NC}"
fi

# ── Gate 3: Self-Healing Scan ──────────────────────
echo ""
echo "Running aden heal --scan..."
if command -v aden >/dev/null 2>&1; then
    OUTPUT=$(aden heal --scan . 2>&1 || true)
    if echo "$OUTPUT" | grep -q "^ERROR:"; then
        echo -e "${RED}Drift errors detected. Review with 'aden heal --scan .'${NC}"
        EXIT_CODE=$FAIL
    else
        echo -e "${GREEN}No critical drift.${NC}"
    fi
else
    echo -e "${YELLOW}aden CLI not in PATH — skipping heal gate.${NC}"
fi

# ── Gate 4: Tests (fast check only) ────────────────
echo ""
echo "Running cargo test --workspace..."
if command -v cargo >/dev/null 2>&1; then
    if ! cargo test --workspace --quiet >/dev/null 2>&1; then
        echo -e "${RED}Tests failed. Run 'cargo test --workspace' to investigate.${NC}"
        EXIT_CODE=$FAIL
    else
        echo -e "${GREEN}All tests passed.${NC}"
    fi
else
    echo -e "${YELLOW}cargo not in PATH — skipping test gate.${NC}"
fi

# ── Final Verdict ──────────────────────────────────
echo ""
if [ $EXIT_CODE -eq $PASS ]; then
    banner "ALL GATES PASSED — Commit approved."
    exit 0
else
    banner "COMMIT BLOCKED — Fix issues above and retry."
    exit 1
fi
