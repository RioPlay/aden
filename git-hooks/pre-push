# Pre-push gate — run the CI checks locally so we NEVER push unvalidated code.
# Mirrors the important parts of .github/workflows/ci.yml plus aden's own
# security/accuracy gate (`aden ci-check`: lint, check, secret scan, OWASP +
# cargo audit, contract freshness).
#
# Activate (once per clone):  git config core.hooksPath git-hooks
# (install.sh wires this automatically.)
# Emergency bypass (use sparingly, and say so):  git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
echo "[pre-push] running CI gate (build → test → aden ci-check)…"

echo "[pre-push] cargo build --workspace"
cargo build --workspace

echo "[pre-push] cargo test --workspace --no-fail-fast"
cargo test --workspace --no-fail-fast

# aden's gate also runs the tests, lint, doc check, secret scan, OWASP + cargo
# audit, and contract freshness. Run via cargo so it uses the current build.
echo "[pre-push] aden ci-check ."
cargo run -q -p aden-cli -- ci-check .

echo "[pre-push] ✓ all gates passed — pushing."
