/target
**/contracts/
**/.aden/

# Generated contract artifacts — NEVER commit these
# aden gen emits .adoc files into contracts/ (gitignored above), but if
# generation runs in-tree, block them at the source level too.
crates/**/*.adoc
benches/**/*.adoc
src/**/*.adoc
Cargo.lock
*.bak
*.swp
*.swo
*.tmp
*.temp
.DS_Store
.vscode/
.idea/

# IDE / Editor runtime files
.opencode/

# Secrets — NEVER commit these
*.pem
*.key
*.p8
*.p12
*.pfx
.env
.env.local
.env.*.local
secrets/
private/
id_rsa
id_ecdsa
id_ed25519
*.pub
!tools/keys/.gitkeep
.den/

# Generated signing artifacts (public keys OK, private NO)
/signatures/
*.sig
asc/
