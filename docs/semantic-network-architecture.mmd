flowchart TB
    subgraph "User Authored .adoc"
        SEM[Semantic Block<br/>[semantics]]
        REF[Inline References<br/><<is-a>>, <<part-of>>]
    end

    subgraph "aden-parse"
        PARSE[Parser]
        SEM -->|extracts| PARSE
        REF -->|extracts| PARSE
    end

    subgraph "aden-graph"
        GRAPH[Knowledge Graph]
        PARSE -->|semantic edges| GRAPH
        NODE1[Node: Noun]
        NODE2[Node: Verb]
        NODE3[Node: PartOfSpeech]
        GRAPH --> NODE1
        GRAPH --> NODE2
        GRAPH --> NODE3
    end

    subgraph "aden-index"
        INV[Inverted Index]
        SA[Spreading Activation]
        GRAPH -->|indexes| INV
        INV -->|semantic search| SA
    end

    subgraph "aden-asm"
        NB[Neural Budget<br/>Token Allocation]
        SA -->|semantic results| NB
    end

    subgraph "Output"
        QUERY[aden query --semantic]
        CTX[aden asm --neural]
        SA --> QUERY
        NB --> CTX
    end

    style SA fill:#ff9800,stroke:#333,color:#fff
    style NB fill:#ff9800,stroke:#333,color:#fff
    style SEM fill:#e8f5e9,stroke:#333
    style REF fill:#e8f5e9,stroke:#333