# Aden Ignore — Security-first defaults
# Contracts are build artifacts; never commit them.
contracts/
.aden/
docs/.aden/
target/
.git/
.opencode/

# Secrets (never process)
*.pem
*.key
*.p8
*.env
.env.local
.env.*

# Editor debris
*.swp
*.swo
.vscode/
.idea/

# Build outputs (cargo/node)
node_modules/
dist/
build/

# OS files
.DS_Store
Thumbs.db
