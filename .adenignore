# Aden Ignore — Security-first defaults
# Contracts are build artifacts; never commit them.
contracts/
.aden/
target/
.git/

# Secrets (never process)
*.pem
*.key
*.p8
*.env
.env.local
.env.*

# Auto-generated configs
.gitignore
.adenignore
Cargo.lock

# Dev tooling
tools/git-hooks/

# Editor debris
*.swp
*.swo
.vscode/
.idea/

# Build outputs (cargo/node)
node_modules/
dist/
build/
Cargo.lock

# OS files
.DS_Store
Thumbs.db
