# Aden Ignore — Security-first defaults
# Contracts are build artifacts; never commit them.
contracts/
.aden/
target/
.git/

# Secrets (never process)
*.pem
*.key
*.p8
*.env
.env.local
.env.*

# Editor debris
*.swp
*.swo
.vscode/
.idea/

# Build outputs (cargo/node)
node_modules/
dist/
build/

# Vendored / minified frontend assets — third-party bundles, not aden source.
# Indexing a minified bundle floods the graph with meaningless single-letter
# symbols (e.g. force-graph.min.js#A) that bucket into a giant `unknown` hub.
*.min.js
*.min.css

# Eval fixtures — sample docs for the retrieval eval harness, not aden's own
# source/docs; keep them out of aden's self-graph and contract checks.
crates/aden-index/tests/corpus/

# OS files
.DS_Store
Thumbs.db

# Real-repo eval sets/docs (about external repos, not aden source).
scripts/eval-sets/
