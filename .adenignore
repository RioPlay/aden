# Aden Ignore — Security-first defaults
# Contracts are build artifacts; never commit them.
/contracts/
/.aden/
/target/
/.git/

# Secrets (never process)
*.pem
*.key
*.p8
*.env
.env.local
.env.*

# Editor debris
*.swp
*.swo
.vscode/
.idea/

# Build outputs (cargo/node)
node_modules/
dist/
build/

# OS files
.DS_Store
Thumbs.db

# Templates, agent workspace, and high-level docs (orphans by design)
.agent/
.aden/
docs/
README.adoc
